{{#> layout
  title='The fastest way to learn a language'
  metaDescription=''
  url='/ai.html'
  ogDescription=''
  navbarAlwaysMurky=true
  navbarSpacing="mb-0"
  navbarContainerClass="container-md"
  noCta=true
  nonStickyNavbar=true
  disabledAutoTrack=true
}}
  <style>
    :root {
      --info-radius: 0.75rem;
      --info-padding: 1.25rem;
    }

    .select-language {
      border-radius: var(--info-radius);
      border: none;
      box-shadow: none;
      padding: var(--info-padding);
    }

    .info-panel {
      padding: var(--info-padding);
      background: #fff;
      border-radius: var(--info-radius);
    }

    .info-panel[hidden] {
      display: none;
    }

    #ai-tabs {
      .ai-tabs-nav {
        display: flex;
        gap: 0.25rem;
        padding: 0.25rem;
        margin-bottom: 1rem;
        background: #ececec;
        border-radius: var(--info-radius);
      }

      .ai-tab {
        flex: 1 1 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        padding: 0.5rem 0.75rem;
        border: 0;
        background: transparent;
        color: var(--bs-secondary-color);
        border-radius: calc(var(--info-radius) - 0.25rem);
        font-weight: 500;
        cursor: pointer;
        transition: background-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
      }

      .ai-tab:hover {
        color: var(--bs-body-color);
      }

      .ai-tab[aria-selected='true'] {
        background: #fff;
        color: var(--bs-body-color);
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12);
      }

      .ai-tab .bi {
        font-size: 1.15em;
        line-height: 1;
      }

      .ai-instruction {
        margin: 0;
      }

      .bi-box-arrow-up-right {
        font-size: 0.85em;
        margin-left: 0.35em;
      }
    }
  </style>
  <div class="container-md">
    <div class="pt-3 pb-5">
      <h1 class="h3">The fasted way to learn a language.</h1>

      <p>Do you know why children pick up languages almost immediately and adults struggle? Because:</p>

      <ul>
        <li>Children use language to ask questions and complain about problems</li>
        <li>Adults mostly use language to answer questions and solve someone else's problems</li>
      </ul>
    </div>
  </div>
  <div style="background: #f9f9f9;">
    <div class="container-md py-5" style="font-size: 80%">
      <h2 class="h5" style="color: var(--bs-body-color); font-size: 140%">An AI prompt</h2>

      <div class="mb-4">
        <p>What language are you learning?</p>

        <select id="language" name='language' aria-label='Language' class="select-language form-select form-select-sm mb-4">
          {{#each htmlWebpackPlugin.options.environment.languages}}
            <option value='{{this.code}}'>{{this.label}}</option>
          {{/each}}
        </select>

        <p>Awesome! Now copy this prompt:</p>

        <style>
          #prompt-wrapper {
            font-size: 90%;
            white-space: pre-wrap;
            position: relative;

            #copy-button {
              position: absolute;
              bottom: var(--info-padding);
              right: var(--info-padding);
              display: flex;
              align-items: center;
              gap: 0.5rem;
              border-radius: 0.5rem;
              letter-spacing: -0.02em;
              font-size: 90%;
            }
          }
        </style>

        <pre class="info-panel" style="margin-bottom: 2rem;" id="prompt-wrapper"><code id="prompt"></code><button class="btn btn-secondary btn-sm" id="copy-button"><i class="bi bi-copy"></i><span>Copy</span></button></pre>

        <p>You are amazing! Now add this prompt to the context of AI you are using:</p>

        <div id="ai-tabs">
          <div class="ai-tabs-nav" role="tablist" aria-label="AI assistant">
            <button
              type="button"
              role="tab"
              class="ai-tab"
              id="ai-tab-chatgpt"
              data-ai-tab="chatgpt"
              aria-controls="ai-panel-chatgpt"
              aria-selected="true"
            ><i class="bi bi-chat-dots"></i>ChatGPT</button>
            <button
              type="button"
              role="tab"
              class="ai-tab"
              id="ai-tab-gemini"
              data-ai-tab="gemini"
              aria-controls="ai-panel-gemini"
              aria-selected="false"
              tabindex="-1"
            ><i class="bi bi-stars"></i>Gemini</button>
            <button
              type="button"
              role="tab"
              class="ai-tab"
              id="ai-tab-claude"
              data-ai-tab="claude"
              aria-controls="ai-panel-claude"
              aria-selected="false"
              tabindex="-1"
            ><i class="bi bi-asterisk"></i>Claude</button>
          </div>

          <div
            class="info-panel"
            role="tabpanel"
            id="ai-panel-chatgpt"
            data-ai-panel="chatgpt"
            aria-labelledby="ai-tab-chatgpt"
          >
            <p class="ai-instruction">Paste the prompt into the <strong>Custom instructions</strong> section of <a
                href="https://chatgpt.com/#settings/Personalization"
                target="_blank"
                rel="noopener"
                class="link-secondary"
              >Personalization<i class="bi bi-box-arrow-up-right"></i></a>.</p>
          </div>

          <div
            class="info-panel"
            role="tabpanel"
            id="ai-panel-gemini"
            data-ai-panel="gemini"
            aria-labelledby="ai-tab-gemini"
            hidden
          >
            <p class="ai-instruction">Open <a
                href="https://gemini.google.com/saved-info"
                target="_blank"
                rel="noopener"
                class="link-secondary"
              >Personal context<i class="bi bi-box-arrow-up-right"></i></a>, tick the <strong>Your instructions for
                Gemini</strong> checkbox, then click <strong>+ Add</strong> and paste the prompt.</p>
          </div>

          <div
            class="info-panel"
            role="tabpanel"
            id="ai-panel-claude"
            data-ai-panel="claude"
            aria-labelledby="ai-tab-claude"
            hidden
          >
            <p class="ai-instruction">Paste the prompt into the <strong>Instructions for Claude</strong> section of your <a
                href="https://claude.ai/settings/profile"
                target="_blank"
                rel="noopener"
                class="link-secondary"
              >Claude Profile<i class="bi bi-box-arrow-up-right"></i></a>.</p>
          </div>
        </div>
      </div>
      {{> social-share
      }}
    </div>
  </div>
{{/layout}}

